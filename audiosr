def build_parser():
    parser = argparse.ArgumentParser(
        description="Upscale audio to 48 kHz with FlashSR (default) or AudioSR.",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )
    parser.add_argument("input", nargs="?", help="input audio file (mp3, wav, flac, ...)")
    parser.add_argument("output", nargs="?", help="output .flac path (default: input with .flac)")
    parser.add_argument("--engine", default="flashsr", choices=["flashsr", "audiosr"],
                        help="flashsr is one-step and ~9x faster; audiosr is the diffusion sampler")
    parser.add_argument("--model", default="basic", choices=["basic", "speech"],
                        help="[audiosr only] weight variant")
    parser.add_argument("--steps", type=int, default=50, help="[audiosr only] denoising steps")
    parser.add_argument("--guidance", type=float, default=3.5, help="[audiosr only] CFG scale")
    parser.add_argument("--seed", type=int, default=0, help="[audiosr only] seed, 0 = random")
    parser.add_argument("--chunk-size", type=float, default=15.0,
                        help="[audiosr only] chunk length in seconds")
    parser.add_argument("--overlap", type=float, default=1.0,
                        help="overlap between chunks/windows in seconds")
    parser.add_argument("--lowpass", action=argparse.BooleanOptionalAction, default=True,
                        help="[flashsr only] lowpass the input and auto-detect the cutoff")
    parser.add_argument("--device", default="cuda", choices=["cuda", "cpu"],
                        help="compute device")
    parser.add_argument("--model-dir", default=None,
                        help="weights directory (default: $FLASHSR_MODEL_DIR, ./models, "
                             "or the ComfyUI models directory)")
    parser.add_argument("--node-dir", default=None,
                        help="directory containing the FlashSR package "
                             "(default: $FLASHSR_DIR, ./flashsr, or a ComfyUI install)")
    parser.add_argument("--sample-rate", type=int, default=SAMPLE_RATE,
                        help="output sample rate")
    parser.add_argument("--normalize", action="store_true",
                        help="peak-normalize output to -0.1 dBFS")
    parser.add_argument("--download", action="store_true",
                        help="download missing FlashSR weights from HuggingFace")
    parser.add_argument("--check", action="store_true",
                        help="run the install/GPU/model preflight gate and exit")
    parser.add_argument("--play", action="store_true",
                        help="stream through FlashSR to a PulseAudio/PipeWire sink "
                             "instead of writing a file")
    parser.add_argument("--sink", default="@DEFAULT_SINK@",
                        help="[--play] PulseAudio sink name (pacat --device)")
    parser.add_argument("--window", type=float, default=5.12,
                        help="[--play] FlashSR window in seconds (multiple of 0.64; "
                             "5.12 = trained length, smaller = lower latency)")
    parser.add_argument("--dtype", default="bf16", choices=["bf16", "fp32"],
                        help="[--play] compute precision (bf16 is ~17%% faster)")
    parser.add_argument("--cutoff", type=float, default=None,
                        help="[--play] fixed lowpass cutoff in Hz (default: auto, "
                             "detected once from the first window)")
    parser.add_argument("--latency", type=int, default=500,
                        help="[--play] requested sink latency in ms")
    parser.add_argument("--dump", default=None,
                        help="[--play] write the streamed result to this FLAC "
                             "instead of playing it")
    parser.add_argument("--listen", action="store_true",
                        help="middleware mode: create a virtual sink, upscale whatever "
                             "is routed into it, and play it on the real sink")
    parser.add_argument("--virtual-name", default="audiosr_in",
                        help="[--listen] name of the virtual sink to create")
    parser.add_argument("--skip-silence", action=argparse.BooleanOptionalAction,
                        default=True,
                        help="pass digital silence through without a GPU pass "
                             "(keeps the daemon idle when nothing is playing)")
    parser.add_argument("--take-default", action="store_true",
                        help="[--listen] make the virtual sink the default while running")
    parser.epilog = (
        "The FlashSR package is looked up in $FLASHSR_DIR, ./flashsr, "
        "./vendor/flashsr, and ComfyUI custom_nodes (set COMFYUI_DIR or "
        "FLASHSR_DIR to override). Weights come from $FLASHSR_MODEL_DIR, "
        "./models, or the ComfyUI models directory; --download fetches them."
    )
    return parser


def main():
    args = build_parser().parse_args()
    reexec_with_venv()

    if args.listen:
        return listen(args)
    if args.play:
        return play(args)

    info = preflight(args)
    if info is None:
        return 1
    if args.check:
        return 0

    if not args.input:
        sys.exit("[audiosr] No input file given (or use --check)")
    if not os.path.exists(args.input):
        sys.exit(f"[audiosr] Input not found: {args.input}")

    if args.engine == "flashsr" and args.download:
        download_flashsr_weights(info["model_dir"])
        missing = [
            name for name in FLASHSR_FILES
            if not os.path.isfile(os.path.join(info["model_dir"], name))
        ]
        if missing:
            sys.exit(f"[audiosr] Download incomplete; still missing: {', '.join(missing)}")

    output = args.output or os.path.splitext(args.input)[0] + ".flac"
    output_dir = os.path.dirname(os.path.abspath(output))
    os.makedirs(output_dir, exist_ok=True)

    import warnings

    warnings.filterwarnings("ignore")
    os.environ.setdefault("PYTORCH_CUDA_ALLOC_CONF", "expandable_segments:True")

    import librosa
    import numpy as np
    import soundfile as sf
    import torch

    device = info["device"]
    if args.engine == "flashsr":
        print(f"[audiosr] Engine: FlashSR (1-step), lowpass={args.lowpass}, overlap={args.overlap}s")
    else:
        print(f"[audiosr] Engine: AudioSR {args.model}, steps={args.steps}, "
              f"guidance={args.guidance}, overlap={args.overlap}s")

    print(f"[audiosr] Input:  {args.input}")
    print(f"[audiosr] Output: {output}")
    print(f"[audiosr] Loading audio at {SAMPLE_RATE} Hz...", flush=True)
    data, _ = librosa.load(args.input, sr=SAMPLE_RATE, mono=False)
    if data.ndim == 1:
        data = data[np.newaxis, :]
    print(f"[audiosr] Loaded {data.shape[1] / SAMPLE_RATE:.1f}s, {data.shape[0]} channel(s)")

    started = time.time()
    if args.engine == "flashsr":
        print("[audiosr] Loading FlashSR weights...", flush=True)
        model = load_flashsr(info["pkg_dir"], info["model_dir"], device)
        print(f"[audiosr] Model loaded in {time.time() - started:.1f}s", flush=True)
        audio = upscale_flashsr(model, data, args)
    else:
        print("[audiosr] Loading AudioSR weights...", flush=True)
        model = load_audiosr(info["node_dir"], info["model_dir"], args.model, device)
        print(f"[audiosr] Model loaded in {time.time() - started:.1f}s", flush=True)
        audio = upscale_audiosr(model, data, args)

    if args.sample_rate != SAMPLE_RATE:
        audio = np.stack(
            [librosa.resample(channel, orig_sr=SAMPLE_RATE, target_sr=args.sample_rate) for channel in audio],
            axis=0,
        )

    audio = np.nan_to_num(audio, nan=0.0, posinf=0.0, neginf=0.0)
    peak = float(np.max(np.abs(audio)))
    if args.normalize and peak > 0:
        audio *= 0.9886 / peak
        print(f"[audiosr] Peak normalized from {peak:.2f} to 0.99")
    elif peak > 1.0:
        print(f"[audiosr] Peak {peak:.2f} exceeds 0 dBFS, FLAC write will clip it (use --normalize)")

    sf.write(output, audio.T, args.sample_rate, subtype="PCM_24")
    print(f"[audiosr] Done in {time.time() - started:.1f}s -> {output}")
    print(f"[audiosr] {audio.shape[1] / args.sample_rate:.1f}s, {audio.shape[0]}ch, "
          f"{args.sample_rate} Hz, 24-bit FLAC")
    return 0


if __name__ == "__main__":
    sys.exit(main())
